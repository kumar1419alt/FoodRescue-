# Server configuration only. Copy this file to .env.local; never commit real values.
# PostgreSQL used by the app and Prisma migrations. Use URL-encoded credentials.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/foodrescue_dev?schema=public"
# An isolated database used only by `npm run test:db`; its name must end in `_test`.
DATABASE_TEST_URL="postgresql://USER:PASSWORD@HOST:5432/foodrescue_test?schema=public"
# AUTH_SECRET="generate-a-long-random-secret-during-the-authentication-phase"
# APP_URL="http://localhost:3000"
